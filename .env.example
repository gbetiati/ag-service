DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ag_service?schema=public"
PORT=3000
REDIS_HOST=localhost
REDIS_PORT=6379
BULL_BOARD_ENABLED=true
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=replace-with-a-strong-password

VIDEO_GENERATION_CONCURRENCY=2
VIDEO_VALIDATION_CONCURRENCY=1
SOCIAL_PUBLISHING_CONCURRENCY=2
STORAGE_ROOT="./storage/uploads"
CREATOMATE_API_KEY="your-creatomate-api-key"
PUBLIC_API_BASE_URL="https://api.example.com"
MEDIA_ASSET_URL_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
IDENTITY_EMAIL_VERIFICATION_REQUIRED=true
JWT_ACCESS_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="no-reply@example.com"
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
META_LOGIN_CONFIG_ID="1105089312142112"
META_OAUTH_REDIRECT_URI="https://your-tunnel-host/auth/instagram/callback"
META_OAUTH_STATE_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
META_GRAPH_API_VERSION="v21.0"
INSTAGRAM_TEST_IMAGE_URL="https://example.com/public-test-image.jpg"
CREDENTIAL_ENCRYPTION_KEY="replace-with-a-random-secret-at-least-32-characters-long"

# Required for generating ideas and scripts in scheduled preparations.
SCHEDULED_CONTENT_OPENAI_API_KEY=
SCHEDULED_CONTENT_OPENAI_MODEL=

# Provider callbacks for scheduled script and video generation.
SCHEDULED_OPENAI_WEBHOOK_SECRET=
SCHEDULED_CREATOMATE_WEBHOOK_SECRET=
